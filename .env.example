# ── CyberShield Cloud Environment Configuration ──────────────────────────────
# Application Port (automatically overridden by cloud providers like Render/Fly/Cloud Run)
PORT=8501
API_PORT=8000

# Runtime Environment (development | staging | production)
ENV=production

# Operating Mode: "dashboard" (Streamlit SOC UI), "api" (Ingestion Gateway), "dual" (both)
APP_MODE=dashboard

# Multi-Agent Orchestration Settings
AGENT_ORCHESTRATION_ENABLED=true
AGENT_LOG_LEVEL=INFO
AGENT_AUTO_MITIGATION=true

# ML Anomaly Detection Model Contamination Parameter
ML_CONTAMINATION_RATE=0.05

# Cloud Ingestion Gateway Settings
API_TOKEN=cybershield-secret-telemetry-token-2024
CORS_ORIGINS=*
